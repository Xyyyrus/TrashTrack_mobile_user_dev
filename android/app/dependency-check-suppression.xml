<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <suppress>
        <dependency>
            <groupId>android.permission.ACCESS_BACKGROUND_LOCATION</groupId>
            <artifactId>dangerous permission</artifactId>
            <version>1.0</version>
        </dependency>
        <reason>Permission is required for app functionality related to location tracking.</reason>
    </suppress>
    <suppress>
        <dependency>
            <groupId>android.permission.ACCESS_COARSE_LOCATION</groupId>
            <artifactId>dangerous permission</artifactId>
            <version>1.0</version>
        </dependency>
        <reason>Permission is necessary to provide approximate location features.</reason>
    </suppress>
    <suppress>
        <dependency>
            <groupId>android.permission.ACCESS_FINE_LOCATION</groupId>
            <artifactId>dangerous permission</artifactId>
            <version>1.0</version>
        </dependency>
        <reason>Permission is essential for accessing precise location for navigation purposes.</reason>
    </suppress>
</suppressions>
